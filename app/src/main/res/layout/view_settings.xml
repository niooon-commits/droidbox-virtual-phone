<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Device Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Virtual Device Information"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Model: Google Pixel 8 Pro (Husky)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OS Version: Android 14 (API Level 34)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kernel: Linux 6.1.25-droidbox-vphone (C++20)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Virtual Sandbox: /data/user/0/ (UID 10001)"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Engine & Security Specs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sandboxing &amp; Security Isolation"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• PID &amp; Mount Namespaces: Isolated"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Binder IPC ioctl Hook: ACTIVE"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• GMS Core &amp; Play Protect: Virtualized (GSF ID: a8f2d9c0e4b1a7f3)"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Root Access Mode: Disabled (Host Integrity Safe)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Live C++ Diagnostics Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C++ Engine Telemetry (libdroidbox_native.so)"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSettingsDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C2E"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="12dp"
            android:text="Loading native engine status..." />

    </LinearLayout>
</ScrollView>
