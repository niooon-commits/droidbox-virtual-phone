<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DroidBox Virtual Phone"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Android-inside-Android Sandboxed C++ Virtual OS"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#1E293B"
        android:textColor="#A7F3D0"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:padding="12dp"
        android:text="Status: Ready" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnToggleOS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Virtual OS"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnLaunchPlayStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Virtual Google Play Store"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnLaunchYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Virtual YouTube"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnInstallApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Install APK into Sandbox"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnFloatingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Switch to Floating Window Mode"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>
