<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Icon -->
        <TextView
            android:id="@+id/tvItemIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_app_icon_circle"
            android:gravity="center"
            android:text="📱"
            android:textSize="22sp" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp Messenger"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Communication • 48 MB • ★ 4.7"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvItemDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sandboxed messaging with virtual media sandbox"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Install Button -->
        <Button
            android:id="@+id/btnItemInstall"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:text="Install"
            android:textSize="11sp"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Download / Installation Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbItemProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvItemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:text="Downloading virtual package..." />

</LinearLayout>
