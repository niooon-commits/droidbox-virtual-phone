<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1D"
    android:padding="16dp">

    <!-- Store Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etStoreSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Search apps, games, utilities..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCategoryAll"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:text="Featured"
                android:textSize="11sp"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCategorySocial"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:text="Social &amp; Chat"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCategoryTools"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:text="Tools &amp; Media"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnDirectApkInstall"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:text="📥 Install Custom APK"
                android:textSize="11sp"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Apps List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llStoreAppsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- App cards populated programmatically or via templates -->
        </LinearLayout>
    </ScrollView>

</LinearLayout>
